# ── Supabase (server-side) ─────────────────────────────────────────
SUPABASE_URL=              # e.g. https://xxxx.supabase.co
SUPABASE_ANON_KEY=         # public anon key
SUPABASE_SERVICE_ROLE_KEY= # service-role key (server only, NEVER expose to browser)

# ── Supabase (exposed to browser via Vite) ────────────────────────
VITE_SUPABASE_URL=         # same project URL
VITE_SUPABASE_ANON_KEY=    # same anon key

# ── Google OAuth (for sending email via Gmail) ────────────────────
GOOGLE_CLIENT_ID=          # from Google Cloud Console OAuth client
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=       # http://localhost:3000/api/google/callback (dev)
                           # https://<your-domain>/api/google/callback (prod)
